# Public build-time API base URL. Never place provider keys in VITE_*.
VITE_API_URL=https://your-project.vercel.app
# GitHub Pages build only; Vercel builds use /.
# PAGES_BASE=/iser-clinician-portal/

# Vercel Production secrets/configuration (not required for prepared demo):
# OPENROUTER_API_KEY=
# DEMO_ACCESS_CODE_HASH=sha256-hex-of-access-code
# SESSION_SECRET=random-string-at-least-32-characters
# KV_REST_API_URL=https://your-redis-rest-endpoint
# KV_REST_API_TOKEN=
# ALLOWED_ORIGINS=https://your-account.github.io,http://127.0.0.1:5173
