{
  "name": "iser-clinician-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run prompts:check && npm run prompt-workbench && tsc --noEmit && vite build",
    "test": "npm run prompts:check && vitest run --root .",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "handbook": "npm run prompts:check && npm run prompt-workbench && tsx scripts/build-handbook.ts",
    "prompts:sync": "tsx scripts/sync-prompts.ts",
    "prompts:check": "tsx scripts/sync-prompts.ts --check",
    "prompt-workbench": "tsx scripts/build-prompt-workbench.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/functions": "^3.10.1",
    "lucide-react": "1.58.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "marked": "^18.1.1",
    "puppeteer": "^25.14.0",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
